npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# === IDE / EDITORES ===
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# === REACT ===
.eslintcache

# === TEMPORALES ===
.cache/
.parcel-cache/
.next/
.nuxt/
.vuepress/dist
.serverless/
